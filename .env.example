# Local dev: SQLite file
DATABASE_URL="file:./dev.db"

# Production (Turso): full libsql:// URL with the auth token embedded as a
# query param — see "프로덕션 DB (Turso)" in README.md for how to get these.
# DATABASE_URL="libsql://<db>-<org>.turso.io?authToken=<token>"

# Admin login password (change this before deploying)
ADMIN_PASSWORD="changeme123"

# Used to encrypt the admin session cookie. Must be at least 32 characters.
SESSION_SECRET="replace-with-a-random-32-plus-character-string"

# Base URL used for metadata, sitemap, and og:image generation
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google AdSense publisher/client ID (e.g. ca-pub-XXXXXXXXXXXXXXXX)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-xxxxxxxxxxxxxxxx"

# Search engine site-ownership verification (HTML tag method — just the
# "content" value from the meta tag each console gives you, not the whole tag)
# GOOGLE_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# NAVER_SITE_VERIFICATION="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
